{
  "name": "campbell-co-leeway-governed",
  "private": true,
  "version": "1.0.0",
  "description": "Campbell & Co. luxury storefront governed by LeeWay Standards.",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --port=3000 --host=0.0.0.0",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "pages:spa": "node -e \"require('fs').copyFileSync('dist/index.html', 'dist/404.html')\"",
    "build:pages": "npm run build && npm run pages:spa",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "node ./node_modules/typescript/bin/tsc --noEmit",
    "leeway:audit": "node ./.leeway/scripts/compliance-check.mjs .",
    "leeway:align": "node ./.leeway/scripts/auto-enforce-file-governance.mjs --root . --apply",
    "leeway:doctor": "node ./.leeway/scripts/compliance-check.mjs .",
    "leeway:compliance": "node ./.leeway/scripts/compliance-check.mjs .",
    "leeway:headers": "npm run leeway:align"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "firebase": "^12.12.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.15.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
