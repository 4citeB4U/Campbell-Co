{
  "version": "1.0.0",
  "project": {
    "name": "campbell-co-leeway-governed",
    "author": "Campbell & Co.",
    "license": "PROPRIETARY"
  },
  "rootDir": ".",
  "agents": {
    "align": {
      "dryRun": false
    },
    "audit": {
      "outputDir": "reports"
    },
    "health": {
      "timeout": 5000
    }
  },
  "compliance": {
    "minimumScore": 95,
    "blockOnFail": true
  },
  "policies": {
    "NO_SECRETS_IN_CODE": { "enforced": true },
    "HEADERS_REQUIRED": { "enforced": true },
    "TAGS_REQUIRED": { "enforced": true },
    "NO_CIRCULAR_DEPS": { "enforced": true },
    "NAMING_CONVENTIONS": { "enforced": true },
    "PLACEMENT_RULES": { "enforced": true }
  },
  "ignore": [
    "node_modules/**",
    "dist/**",
    "build/**",
    ".next/**",
    "coverage/**",
    "*.min.js"
  ]
}
